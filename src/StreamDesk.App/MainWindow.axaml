<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StreamDesk.App.ViewModels"
        xmlns:views="clr-namespace:StreamDesk.App.Views"
        x:Class="StreamDesk.App.MainWindow"
        Title="StreamDesk"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BkgBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0"
                Width="{Binding IsNavExpanded, Converter={x:Static vm:Converters.ExpandedToSidebarWidth}}">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="18,18,18,10" Orientation="Horizontal" Spacing="10">
                    <Panel Width="28" Height="28">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="7" Width="28" Height="28" />
                        <Path Data="M 10,7 L 10,21 L 20,14 Z" Fill="White" />
                    </Panel>
                    <TextBlock Text="StreamDesk" FontWeight="Bold" FontSize="17"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               IsVisible="{Binding IsNavExpanded}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Nav items -->
                <StackPanel Grid.Row="1" Margin="10,6" Spacing="2">
                    <RadioButton Classes="navItem" GroupName="nav" IsChecked="True"
                                 Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.NavHome}}"
                                 Command="{Binding NavigateHomeCommand}" />
                    <RadioButton Classes="navItem" GroupName="nav"
                                 Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.NavMovies}}"
                                 Command="{Binding NavigateMoviesCommand}" />
                    <RadioButton Classes="navItem" GroupName="nav"
                                 Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.NavShows}}"
                                 Command="{Binding NavigateShowsCommand}" />
                    <RadioButton Classes="navItem" GroupName="nav"
                                 Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.NavAnime}}"
                                 Command="{Binding NavigateAnimeCommand}" />
                    <RadioButton Classes="navItem" GroupName="nav"
                                 Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.NavLive}}"
                                 Command="{Binding NavigateLiveTvCommand}" />
                    <RadioButton Classes="navItem" GroupName="nav"
                                 Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.NavDownloads}}"
                                 Command="{Binding NavigateDownloadsCommand}" />
                    <RadioButton Classes="navItem" GroupName="nav"
                                 Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.NavFavorites}}"
                                 Command="{Binding NavigateFavoritesCommand}" />
                    <RadioButton Classes="navItem" GroupName="nav"
                                 Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.NavSettings}}"
                                 Command="{Binding NavigateSettingsCommand}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10,10">
                    <Button Classes="subtle" HorizontalAlignment="Stretch"
                            Content="{Binding IsNavExpanded, Converter={x:Static vm:Converters.CollapseLabel}}"
                            Command="{Binding ToggleNavCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Main area ===================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Top bar -->
            <Border Grid.Row="0" Padding="22,12" Background="{DynamicResource BkgBrush}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" Name="SearchBox" MaxWidth="460" Watermark="Search movies, shows, channels…  (Ctrl+K)"
                             Text="{Binding SearchText}" HorizontalAlignment="Left" />
                    <Button Grid.Column="1" Classes="subtle" Margin="10,0,0,0" Content="Help (F1)"
                            Command="{Binding ToggleHelpCommand}" />
                </Grid>
            </Border>

            <!-- Page content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPageViewModel}" Margin="0" />

            <!-- Details overlay -->
            <Panel Grid.Row="1" IsVisible="{Binding IsDetailsOpen}">
                <Border Background="{DynamicResource OverlayScrimBrush}" />
                <Border Background="{DynamicResource BkgBrush}" CornerRadius="0"
                        Margin="60,30,60,30" ClipToBounds="True">
                <ContentControl Grid.Row="1" Content="{Binding Details}" />
                </Border>
            </Panel>

            <!-- Help overlay -->
            <Panel Grid.Row="1" IsVisible="{Binding IsHelpOpen}">
                <Border Background="{DynamicResource OverlayScrimBrush}" />
                <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="14"
                        Width="520" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <views:HelpDialog />
                </Border>
            </Panel>
        </Grid>
    </Grid>
</Window>
