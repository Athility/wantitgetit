<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StreamDesk.App.Themes.Controls">
  <!-- Shared control polish on top of Fluent. All colors come from theme
       resources (Tokens/LightDark); no screen hard-codes colors. -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BkgBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
  </Style>

  <Style Selector="Border.card:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
  </Style>

  <!-- Sidebar buttons -->
  <Style Selector="RadioButton.navItem">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="RadioButton.navItem:pointerover /template/ ContentPresenter#PART_RadioButtonContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="RadioButton.navItem:checked /template/ ContentPresenter#PART_RadioButtonContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Media cards -->
  <Style Selector="Border.posterCard">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.posterCard:hover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Typography helpers -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Section headers -->
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,18,0,10" />
  </Style>

  <!-- Buttons: accent primary -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C40810" />
  </Style>

  <!-- Subtle/ghost buttons -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- ListBox items used as rows -->
  <Style Selector="ListBoxItem.rowItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Scroll bar slimming -->
  <Style Selector="ScrollBar">
    <Setter Property="MaxHeight" Value="0" />
  </Style>

  <!-- Progress ring text -->
  <Style Selector="TextBlock.percentLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
</Styles>
