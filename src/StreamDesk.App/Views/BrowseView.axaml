<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:StreamDesk.App.Views"
             x:Class="StreamDesk.App.Views.BrowseView">
    <ScrollViewer Padding="28,10">
        <StackPanel Spacing="10">
            <TextBlock Text="{Binding Title}" Classes="h1" Margin="0,6,0,4" />
            <TextBlock Text="Loading…" Classes="secondary" IsVisible="{Binding IsLoading}" />
            <TextBlock Text="{Binding Error}" Classes="secondary" Foreground="{DynamicResource AccentBrush}"
                       IsVisible="{Binding HasError}" />
            <TextBlock Text="Nothing here yet. Configure a provider in Settings → Media Providers."
                       Classes="secondary" Margin="0,16,0,0"
                       IsVisible="{Binding IsEmpty}" />

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:MediaCardView Margin="0,0,12,14" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
